#!/bin/sh
# The repo is public: only main may be published, and only after scripts/check-public.sh passes on
# exactly the commits being pushed (docs/handoff/runbook.md).
top=$(git rev-parse --show-toplevel)
z=0000000000000000000000000000000000000000
status=0
while read -r lref lsha rref rsha; do
  if [ "$lsha" = "$z" ]; then
    echo "pre-push: refusing to delete $rref" >&2
    exit 1
  fi
  if [ "$rref" != refs/heads/main ]; then
    echo "pre-push: only main is published; refusing $rref" >&2
    exit 1
  fi
  if [ "$rsha" = "$z" ] || ! git cat-file -e "$rsha^{commit}" 2>/dev/null; then
    range=$lsha # new remote branch or unknown remote tip: check the whole history
  else
    range=$rsha..$lsha
  fi
  "$top/scripts/check-public.sh" "$range" || status=1
done
exit $status
