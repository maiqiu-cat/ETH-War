# Template for private/deploy/site.env (git-ignored). Copy it there and fill in real values.
# Read by deploy/push.sh (DEPLOY_HOST, DEPLOY_ROOT) and deploy/package.sh (EXPECT_IP → kit).
DEPLOY_HOST=my-server            # ssh alias from ~/.ssh/config
DEPLOY_ROOT=/root/ethwar-deploy  # where kits and the baseline live on the server
EXPECT_IP=203.0.113.10           # public IP ethwar.ondream.ai must resolve to before `cert`
